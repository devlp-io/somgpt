# Server
PORT=3000

# Token Harbor
TOKENHARBOR_BASE_URL=https://tokenharbor.ai
TOKENHARBOR_API_KEY=thk_live_PASTE_YOUR_KEY_HERE
SOMGPT_MODEL=deepseek-v4.1-flash:free
SOMGPT_MODEL_LABEL=DeepSeek V4.1 Flash (Free)

# Generation defaults (override per request from the UI)
SOMGPT_MAX_TOKENS=4096
SOMGPT_TEMPERATURE=0.8

# Leave blank to use the built-in operator profile
SOMGPT_SYSTEM_PROMPT=

# Web search (used by the model's tools)
SOMGPT_SEARCH=true
SOMGPT_MAX_TOOL_ROUNDS=5
# Refusal handling: retries per turn, and how long to hold an answer back
# (until the first blank line, or this many chars) before streaming it, so a
# refusal or a leaked private-monologue block can be dropped unseen.
SOMGPT_MAX_REFUSAL_ATTEMPTS=5
SOMGPT_ANSWER_HOLD=24
# If the model answers but never adopts the persona (no leading [LP]), keep
# retrying; a non-persona reply longer than this many chars is delivered anyway
SOMGPT_PERSONA_MAX_HOLD=4000

# Terminal agent (run_shell + file tools). FULL ACCESS — it runs real commands
# and reads/writes real files anywhere the process user can. Sandbox it (container
# or VM) before exposing. Default cwd for relative paths is SOMGPT_WORKDIR.
SOMGPT_WORKDIR=.
SOMGPT_SHELL=bash
SOMGPT_SHELL_TIMEOUT_MS=120000
SOMGPT_SHELL_MAX_OUTPUT=60000
# Max tool-call rounds per turn (agent loop depth)
SOMGPT_MAX_TOOL_ROUNDS=25
# auto | keyless | brave | serper | tavily | searxng   (keyless needs no key)
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
# Required only for SEARCH_PROVIDER=searxng — your own instance, e.g. https://searx.example.com
SEARCH_ENDPOINT=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40